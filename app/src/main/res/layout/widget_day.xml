<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0CF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/day_breakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00E5FF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRODUCTIVITY"
                android:textColor="#8A93A6"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FF4FA3"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/day_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFC94A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/day_beads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Salat streak beads"
        android:scaleType="fitStart" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#B8C0CF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/day_up"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_plain"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_down"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_plain"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_zoom_out"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_plain"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_zoom_in"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_plain"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_now"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_plain"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Now"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/day_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="Today's timeline"
        android:scaleType="fitXY" />
</LinearLayout>
